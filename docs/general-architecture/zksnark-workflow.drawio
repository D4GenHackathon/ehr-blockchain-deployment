        </mxCell>
        <mxCell id="mC6" value="ehr::create_record(blob_id, u)  ·  zk_verifier::create_consent(circuit_id, valid_until)" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="315" y="1000" as="sourcePoint" /><mxPoint x="1255" y="1000" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mC7" value="[UC2]  dataset::publish_snapshot(records_root)  ·  draw_sample_index()" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="885" y="1032" as="sourcePoint" /><mxPoint x="1255" y="1032" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mC8" value="emit RecordCreated · ConsentCreated · SnapshotPublished · SampleIndexDrawn" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1255" y="1064" as="sourcePoint" /><mxPoint x="1075" y="1064" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ===================== PHASE 4 MESSAGES ===================== -->
        <mxCell id="mD1" value="query: is age ∈ [min, max]?  are condition + treatment in the whitelists?" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="875" y="1155" as="sourcePoint" /><mxPoint x="315" y="1155" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mD2" value="POST /v1/proofs { circuit_id, public inputs, blob refs }" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="315" y="1185" as="sourcePoint" /><mxPoint x="495" y="1185" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mD3" value="fetch blob + Seal key shares; decrypt inside the enclave" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="505" y="1215" as="sourcePoint" /><mxPoint x="685" y="1215" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mD4" value="encrypted EHR payload" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="685" y="1245" as="sourcePoint" /><mxPoint x="505" y="1245" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mD5" value="witness generation (wasm) on tmpfs + rapidsnark Groth16 prove: R(u, w) = 1&lt;br&gt;the witness never leaves the CVM — no host-side plaintext, no proof non-leakage assumption" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="505" y="1268" as="sourcePoint" /><mxPoint x="505" y="1294" as="targetPoint" />
            <Array as="points"><mxPoint x="565" y="1268" /><mxPoint x="565" y="1294" /></Array>
            <mxPoint x="290" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mD6" value="Ed25519-sign WitnessProofClaim{ circuit_id, vk_digest,&lt;br&gt;sha256(proof_bytes), sha256(public_inputs_bytes) }  intent = WITNESS_PROOF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="505" y="1325" as="sourcePoint" /><mxPoint x="505" y="1351" as="targetPoint" />
            <Array as="points"><mxPoint x="565" y="1325" /><mxPoint x="565" y="1351" /></Array>
            <mxPoint x="250" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mD7" value="π · public signals · attestation{ sig, signed_timestamp_ms, enclave pk }" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="495" y="1382" as="sourcePoint" /><mxPoint x="315" y="1382" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mD8" value="[UC2] roots_commitment = H(m_root, t_root, records_root, sample_index)&lt;br&gt;4 roots folded into 1 signal — Sui caps public inputs at 8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="315" y="1405" as="sourcePoint" /><mxPoint x="315" y="1431" as="targetPoint" />
            <Array as="points"><mxPoint x="375" y="1405" /><mxPoint x="375" y="1431" /></Array>
            <mxPoint x="235" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mD9" value="send (π, u, attestation) to the data consumer" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="315" y="1462" as="sourcePoint" /><mxPoint x="875" y="1462" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ===================== PHASE 5 MESSAGES ===================== -->
        <mxCell id="mE1" value="zk_verifier::verify_proof_attested(vk, consent, enclave, enclave_config,&lt;br&gt;proof_bytes, public_inputs_bytes, sig, max_age_ms, clock)" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="885" y="1560" as="sourcePoint" /><mxPoint x="1255" y="1560" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mE2" value="1. assert_signed: intent scope, freshness (max_age_ms), config_version&lt;br&gt;checked BEFORE the pairing — an unattested proof never costs a groth16 verify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1265" y="1600" as="sourcePoint" /><mxPoint x="1265" y="1626" as="targetPoint" />
            <Array as="points"><mxPoint x="1325" y="1600" /><mxPoint x="1325" y="1626" /></Array>
            <mxPoint x="-250" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mE3" value="2. consent expiry vs Clock (EConsentExpired / ENotConsentOwner)&lt;br&gt;3. sui::groth16::verify_groth16_proof over BN254" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1265" y="1657" as="sourcePoint" /><mxPoint x="1265" y="1683" as="targetPoint" />
            <Array as="points"><mxPoint x="1325" y="1657" /><mxPoint x="1325" y="1683" /></Array>
            <mxPoint x="-230" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mE4" value="emit AttestedProofVerified{ circuit_id, result, enclave_pk, config_version, ts }" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1255" y="1714" as="sourcePoint" /><mxPoint x="1075" y="1714" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mE5" value="alt: verify_proof_batched_attested(...) → PendingBatch  (+ verify_proof_batched_decoy padding)" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="885" y="1748" as="sourcePoint" /><mxPoint x="1255" y="1748" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mE6" value="flush_batch: shuffle queued outcomes, MIN_BATCH_SIZE = 8&lt;br&gt;anonymity set — a single outcome cannot be linked back to one request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1265" y="1772" as="sourcePoint" /><mxPoint x="1265" y="1798" as="targetPoint" />
            <Array as="points"><mxPoint x="1325" y="1772" /><mxPoint x="1325" y="1798" /></Array>
            <mxPoint x="-240" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mE7" value="emit BatchFlushed  ·  compliance::PolicyDecision" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1255" y="1836" as="sourcePoint" /><mxPoint x="1075" y="1836" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mE8" value="tx digest + events → consumer and auditors read the result and the enclave identity" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1065" y="1888" as="sourcePoint" /><mxPoint x="885" y="1888" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ===================== NOTES ===================== -->
        <mxCell id="note1" value="&lt;b&gt;Circuits&lt;/b&gt; (packages/zk-circuits/circuits)&lt;br&gt;&lt;br&gt;UC1 — attribute proofs: age_attribute, dob_attribute, insurance_attribute.&lt;br&gt;Salted Poseidon binding H(x, salt) === x_hash, plus a range check or a Merkle inclusion proof over the coverage tree.&lt;br&gt;&lt;br&gt;UC2 — analysis proofs: age_analysis, dob_analysis, time_effectiveness_analysis. Add condition/treatment whitelist Merkle proofs, a dataset snapshot root and a drawn sample index, folded into one roots_commitment signal." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="24" y="1950" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;Move modules&lt;/b&gt; (packages/contracts/sources)&lt;br&gt;&lt;br&gt;enclave.move — Nitro attestation registry, PCR0/1/2 pinning, versioned EnclaveConfig, domain-separated intent scopes.&lt;br&gt;ceremony.move — chained Phase-2 transcript (CeremonyLog), attest_contribution_tee, self-reported attest_contribution retained.&lt;br&gt;zk_verifier.move — store_vk + vk_digest, consent objects, attested / batched verification, roots_commitment.&lt;br&gt;dataset.move · compliance.move · ehr.move — snapshots, policy decisions, record lifecycle." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="550" y="1950" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="&lt;b&gt;Two different &quot;Marlin&quot;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Marlin Oyster (lifeline 3) is the TEE platform — an AWS Nitro Enclave CVM that runs witness generation, proving and the Phase-2 contribution.&lt;br&gt;&lt;br&gt;Marlin the proof system appears only in the benchmarks: Groth16 (192 B proof, circuit-specific Phase 2) vs PLONK and Marlin (universal, updatable setup — 672 B / 880 B). Groth16 is what is deployed; PLONK and Marlin are the universal-setup alternatives evaluated in the paper." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1076" y="1950" width="500" height="150" as="geometry" />
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;   —— solid arrow: call / transaction    - - - dashed arrow: return or optional path    ▮ red bar: activation    coloured band: protocol phase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CB8D1;fontSize=10;align=left;spacingLeft=10;fontColor=#33475B;" vertex="1" parent="1">
          <mxGeometry x="24" y="1926" width="1552" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
