        </mxCell>
        <mxCell id="mA2" value="PHASE 1 (universal): Hermez Powers of Tau, bn128 2^k —&lt;br&gt;curve-only, reused as-is across every circuit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
