        <!-- ===================== PHASE 2 MESSAGES ===================== -->
        <mxCell id="mB1" value="enclave::register_enclave(Nitro attestation document)" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="505" y="400" as="sourcePoint" /><mxPoint x="1255" y="400" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mB2" value="verify COSE_Sign1 + AWS cert chain; PCR0/1/2 must match EnclaveConfig&lt;br&gt;⇒ Enclave{ pk, module_id, config_version }" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
