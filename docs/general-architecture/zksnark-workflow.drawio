            <mxPoint x="-230" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mB10" value="append-only, per-circuit ceremony transcript (rounds chain on prev hash)" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1255" y="748" as="sourcePoint" /><mxPoint x="1075" y="748" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ===================== PHASE 3 MESSAGES ===================== -->
        <mxCell id="mC1" value="zk_verifier::store_vk(circuit_id, vk_bytes) → PreparedVerifyingKey + vk_digest = sha256(vk_bytes)" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="315" y="822" as="sourcePoint" /><mxPoint x="1255" y="822" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mC2" value="fill form: witness w = { DoB, age, insurance provider, condition, treatment }" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="125" y="862" as="sourcePoint" /><mxPoint x="305" y="862" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mC3" value="u = Poseidon(w, salt) — salted commitment, computationally hiding&lt;br&gt;(replaces the unsalted u = H(w) of v1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
