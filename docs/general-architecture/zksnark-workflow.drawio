        <!-- ===================== PHASE 1 MESSAGES ===================== -->
        <mxCell id="mA1" value="compile: circom 2.1.8 → R1CS + witness wasm (7 circuits)" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
