            <mxPoint x="240" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mB8" value="ceremony::attest_contribution_tee(round, prev_hash, hash, sig, clock)" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="505" y="679" as="sourcePoint" /><mxPoint x="1255" y="679" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mB9" value="assert_signed + chain checks (EBrokenChain / EWrongRoundNumber /&lt;br&gt;EBadTranscriptHash) → push round → emit TeeContributionAttested" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
