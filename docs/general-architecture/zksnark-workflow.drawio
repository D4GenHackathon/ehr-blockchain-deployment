        </mxCell>
        <mxCell id="mB3" value="ceremony::create_log(circuit_id) → shared CeremonyLog (genesis hash)" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="315" y="482" as="sourcePoint" /><mxPoint x="1255" y="482" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mB4" value="setup-tee.sh: groth16 setup(R1CS, ptau) + contribute round r" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="505" y="515" as="sourcePoint" /><mxPoint x="1445" y="515" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mB5" value="PHASE 2 (circuit-specific): entropy drawn from the CVM RNG,&lt;br&gt;used once, never written out. transcript_hash = sha256(final zkey)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1455" y="540" as="sourcePoint" /><mxPoint x="1455" y="566" as="targetPoint" />
            <Array as="points"><mxPoint x="1515" y="540" /><mxPoint x="1515" y="566" /></Array>
            <mxPoint x="-230" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mB6" value="{circuit}_final.zkey · verification_key.json · transcript_hash" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="597" as="sourcePoint" /><mxPoint x="505" y="597" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mB7" value="Ed25519-sign ContributionClaim{ circuit_id, round,&lt;br&gt;prev_transcript_hash, transcript_hash }  intent = CEREMONY_CONTRIBUTION" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="505" y="622" as="sourcePoint" /><mxPoint x="505" y="648" as="targetPoint" />
