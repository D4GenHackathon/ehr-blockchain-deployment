            <mxPoint x="215" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mC4" value="Seal encrypt (allowlist RBAC) → Walrus blob (RedStuff erasure coding)" style="html=1;endArrow=block;endFill=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="315" y="940" as="sourcePoint" /><mxPoint x="685" y="940" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="mC5" value="blob_id" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
