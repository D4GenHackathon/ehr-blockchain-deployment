        </mxCell>
        <mxCell id="mA3" value="powersOfTau28_hez_final_{POT_POWER}.ptau" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#33475B;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
